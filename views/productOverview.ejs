<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= product.name %> | Premium Store</title>
    <link rel="stylesheet" href="/css/productOverview.css">
    <!-- Google Fonts for High-End Typography -->
    <link rel="preconnect" href="https://googleapis.com">
    <link rel="preconnect" href="https://gstatic.com" crossorigin>
    <link href="https://googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body>
    <div class="bg-glow"></div>
    
    <!-- Modern Structural Breadcrumb -->
    <nav class="breadcrumb" aria-label="Breadcrumb">
        <div class="breadcrumb-container">
            <a href="/">Home</a>
            <svg class="icon-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            <a href="/">Products</a>
            <svg class="icon-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            <span class="current" aria-current="page"><%= product.name %></span>
        </div>
    </nav>

    <!-- Main Container -->
    <main class="product-container" style="--panel-color: <%= product.panelColor || '#4361ee' %>">
        
        <!-- LEFT: Immersive Product Presentation -->
        <section class="product-left">
            <div class="product-image-box" id="tiltBox">
                <div class="image-glow" style="background:<%=product.panelColor%>;"></div>
                <img src="/productImage/<%= product.image %>" alt="<%= product.name %>" id="mainImage" loading="lazy" style="border: 3px solid<%=product.panelColor%>;">
            </div>
        </section>

        <!-- MIDDLE: Detailed Specifications -->
        <article class="product-middle fade-up">
            <header class="product-header">
                <div class="tag-row">
                    <% if (product.stocks > 0) { %>
                        <span class="stock-pill in-stock">⚡ In Stock</span>
                    <% } else { %>
                        <span class="stock-pill out-of-stock">⚠️ Out of Stock</span>
                    <% } %>
                    <% if (product.discount > 0) { %>
                        <span class="discount-badge"><%= product.discount %>% OFF</span>
                    <% } %>
                </div>
                <h1 class="product-title"><%= product.name %></h1>
                
                <div class="rating-row">
                    <div class="stars" aria-label="4 out of 5 stars">★★★★☆</div>
                    <span class="rating-count">1,234 reviews</span>
                </div>
            </header>

            <% const finalPrice = Math.round(product.price - (product.price * (product.discount || 0)) / 100); %>
            <div class="price-section">
                <div class="price-block">
                    <span class="final-price">₹<%= finalPrice.toLocaleString('en-IN') %></span>
                    <% if (product.discount > 0) { %>
                        <span class="mrp-price">M.R.P. <span class="strike">₹<%= product.price.toLocaleString('en-IN') %></span></span>
                    <% } %>
                </div>
                <p class="inclusive-tax">Inclusive of all taxes &middot; <span>Free express delivery</span></p>
            </div>

            <section class="about-section">
                <h2>Product Experience & Details</h2>
                <p class="product-description"><%= product.details %></p>
            </section>

            <footer class="seller-info">
                <div class="seller-card">
                    <div class="seller-avatar">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                    </div>
                    <div class="seller-details">
                        <p class="label">Authorized Seller</p>
                        <p class="value"><%=seller.username%></p>
                        <% if (seller.username && seller.gstin) { %>
                            <p class="gstin">GSTIN: <span><%= seller.gstin %></span></p>
                        <% } %>
                    </div>
                </div>
            </footer>
        </article>

        <!-- RIGHT: Heavy Modern Conversion Buy Box -->
        <aside class="product-right fade-up delay">
            <div class="buybox">
                <div class="buybox-header">
                    <span class="buybox-price">₹<%= finalPrice.toLocaleString('en-IN') %></span>
                    <span class="delivery-badge">Free</span>
                </div>

                <div class="shipping-eta">
                    <div class="eta-item">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                        <p>Delivery inside <strong>2–4 business days</strong></p>
                    </div>
                    <div class="eta-item">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/></svg>
                        <p>7-Day seamless return window</p>
                    </div>
                </div>

                <% if (product.stocks > 0) { %>

                    <div class="action-buttons">
                        <form action="/login/<%=userId%>/product/<%=product._id%>/addToCart%>" method="POST">
                            <input type="hidden" name="productId" value="<%= product._id %>">
                            <input type="hidden" name="qty" id="hiddenQty" value="1">
                            <button type="submit" class="btn btn-secondary">Add to Cart</button>
                        </form>
                        
                        <form action="/login/<%=userId%>/product/<%=product._id%>/buyPage" method="POST">
                            <input type="hidden" name="productId" value="<%= product._id %>">
                            <input type="hidden" name="qty" id="hiddenQtyBuy" value="1">
                            <button type="submit" class="btn btn-primary">Buy Now</button>
                        </form>
                    </div>
                <% } else { %>
                    <button class="btn btn-disabled" disabled>Currently Out of Stock</button>
                <% } %>

                <div class="secure-footer">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                    <span>SSL Encrypted Secure Transaction</span>
                </div>
            </div>
        </aside>
    </main>

    <script>
        // Sync Dropdowns Safely
        const qtySelect = document.getElementById('qty');
        if (qtySelect) {
            qtySelect.addEventListener('change', function() {
                document.getElementById('hiddenQty').value = this.value;
                document.getElementById('hiddenQtyBuy').value = this.value;
            });
        }

        // Advanced 3D Parallax Tilt Effect
        const tiltBox = document.getElementById('tiltBox');
        if (tiltBox) {
            tiltBox.addEventListener('mousemove', (e) => {
                const rect = tiltBox.getBoundingClientRect();
                const x = e.clientX - rect.left;
                const y = e.clientY - rect.top;
                const centerX = rect.width / 2;
                const centerY = rect.height / 2;
                const rotateX = ((y - centerY) / centerY) * -10; 
                const rotateY = ((x - centerX) / centerX) * 10;
                
                tiltBox.style.transform = `perspective(1200px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale3d(1.04, 1.04, 1.04)`;
            });
            
            tiltBox.addEventListener('mouseleave', () => {
                tiltBox.style.transform = `perspective(1200px) rotateX(0deg) rotateY(0deg) scale3d(1, 1, 1)`;
            });
        }
    </script>
</body>
</html>
