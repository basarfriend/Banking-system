<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Owner Panel | Authentication</title>
  <link rel="stylesheet" href="/css/owner.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>
  <main class="owner-page">
    <section class="owner-card">
      
      <!-- Card Header -->
      <div class="card-header">
        <span class="badge">Admin Portal</span>
        <h1 id="headerTitle">Owner Login</h1>
        <a href="/">user panel</a>
        <p id="headerSubtitle">Access your dashboard securely</p>
      </div>

      <!-- Signin Form -->
      <form action="/admin/login" method="POST" id="signinForm" class="auth-form">
        <div class="form-group">
          <label for="login-email">Owner Email</label>
          <input 
            type="email" 
            id="login-email" 
            name="email" 
            placeholder="owner@domain.com" 
            pattern="[a-z0-9._%+\-]+@[a-z0-9.\-]+\.[a-z]{2,}$"
            required
          >
          <span class="error-message">Enter a valid email address</span>
        </div>

        <div class="form-group">
          <label for="login-password">Password</label>
          <input 
            type="password" 
            id="login-password" 
            name="password" 
            placeholder="••••••••" 
            minlength="6"
            required
          >
          <span class="error-message">Password is required (min 6 characters)</span>
        </div>

        <button type="submit" class="btn btn-primary">Login</button>
        
        <p class="toggle-text">
          Need an Owner account? 
          <button type="button" id="showSignupBtn" class="btn-link">Create Account</button>
        </p>
      </form>

      <!-- Signup Form -->
      <form action="/admin/create/account" method="POST" id="signupForm" class="auth-form hidden">
        <div class="form-group">
          <label for="username">Full Name</label>
          <input 
            type="text" 
            id="username" 
            name="username" 
            placeholder="Full Name" 
            pattern="^[A-Za-z\s]{3,30}$" 
            title="Name should be 3-30 alphabetic characters"
            required
          >
          <span class="error-message">Name must be 3-30 letters (no special characters)</span>
        </div>

        <div class="form-group">
          <label for="signup-email">Email</label>
          <input 
            type="email" 
            id="signup-email" 
            name="email" 
            placeholder="owner@domain.com" 
            pattern="[a-z0-9._%+\-]+@[a-z0-9.\-]+\.[a-z]{2,}$"
            required
          >
          <span class="error-message">Enter a valid business email</span>
        </div>

        <div class="form-group">
          <label for="phone">Phone Number</label>
          <input 
            type="tel" 
            id="phone" 
            name="phone" 
            placeholder="10-digit Mobile Number" 
            pattern="^[6-9]\d{9}$" 
            required
          >
          <span class="error-message">Enter a valid 10-digit Indian phone number</span>
        </div>

        <div class="form-group">
          <label for="gstin">GSTIN Number</label>
          <input 
            type="text" 
            id="gstin" 
            name="gstin" 
            placeholder="22AAAAA0000A1Z5" 
            pattern="^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z]{1}[1-9A-Z]{1}Z[0-9A-Z]{1}$" 
            title="Valid 15-character Indian GSTIN"
            style="text-transform: uppercase;"
            required
          >
          <span class="error-message">Enter valid 15-character GSTIN (e.g., 22AAAAA0000A1Z5)</span>
        </div>

        <div class="form-group">
          <label for="signup-password">Password</label>
          <input 
            type="password" 
            id="signup-password" 
            name="password" 
            placeholder="••••••••" 
            pattern="^(?=.*[A-Za-z])(?=.*\d)[A-Za-z\d@$!%*#?&]{8,}$" 
            title="Min 8 chars, at least 1 letter and 1 number"
            required
          >
          <span class="error-message">Min 8 chars, at least 1 letter and 1 number</span>
        </div>

        <button type="submit" class="btn btn-primary">Create Owner Account</button>
        
        <p class="toggle-text">
          Already registered? 
          <button type="button" id="showLoginBtn" class="btn-link">Login</button>
        </p>
      </form>

    </section>
  </main>

  <script src="/js/owner.js"></script>
</body>
</html>