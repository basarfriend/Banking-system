<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= owner.username %>'s Profile</title>
    <link rel="stylesheet" href="/css/admin-profile.css">
    <!-- RemixIcon for modern icons -->
    <link href="https://cdn.jsdelivr.net/npm/remixicon@4.2.0/fonts/remixicon.css" rel="stylesheet">
</head>
<body>

    <div class="admin-layout">
        <!-- Sidebar Navigation -->
        <aside class="sidebar">
            <div class="brand">
                <i class="ri-store-3-line"></i>
                <span>Admin Panel</span>
            </div>
            <nav class="nav-links">
                <a href="/admin/dashboard/<%= owner._id %>/profile" class="active"><i class="ri-user-settings-line"></i> Profile</a>
                <a href="/owner/<%=owner._id%>/productsCreate"><i class="ri-add-circle-line"></i> Add Product</a>
                <form action="/admin/<%=owner._id%>/logout" method="post">
                    <button class="logout-btn"><i class="ri-logout-box-r-line"></i> Logout</button>
                </form>
            </nav>
        </aside>

        <!-- Main Content Area -->
        <main class="main-content">
            <!-- Header Banner -->
            <header class="profile-header">
                <div class="header-left">
                    <div class="avatar">
                        <%= owner.username.charAt(0).toUpperCase() %>
                    </div>
                    <div class="owner-info">
                        <h1><%= owner.username %> <span class="badge">Verified Admin</span></h1>
                        <p><i class="ri-mail-line"></i> <%= owner.email %> | <i class="ri-phone-line"></i> <%= owner.phone || 'N/A' %></p>
                        <p class="gstin-tag"><i class="ri-file-text-line"></i> GSTIN: <strong><%= owner.gstin || 'Not Provided' %></strong></p>
                    </div>
                </div>
                <div class="header-actions">
                    <a href="/owner/<%=owner._id%>/productsCreate" class="btn btn-primary"><i class="ri-add-line"></i> Create New Product</a>
                </div>
            </header>

            <!-- Metrics / Stats Section -->
            <section class="stats-grid">
                <div class="stat-card">
                    <div class="stat-icon blue"><i class="ri-box-3-line"></i></div>
                    <div class="stat-details">
                        <h3>Total Products</h3>
                        <p class="stat-number"><%= stats.totalProducts %></p>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon green"><i class="ri-stack-line"></i></div>
                    <div class="stat-details">
                        <h3>Total Inventory Units</h3>
                        <p class="stat-number"><%= stats.totalStock %></p>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon purple"><i class="ri-money-rupee-circle-line"></i></div>
                    <div class="stat-details">
                        <h3>Est. Inventory Value</h3>
                        <p class="stat-number">₹<%= stats.totalInventoryValue.toLocaleString('en-IN') %></p>
                    </div>
                </div>
            </section>

            <!-- Product Inventory Section -->
            <section class="inventory-section">
                <div class="section-title">
                    <h2>Managed Products (<%= owner.products.length %>)</h2>
                </div>

                <% if (owner.products.length > 0) { %>
                    <div class="product-grid">
                        <% products.forEach(function(product) { %>
                            <div class="product-card" style="border-top: 4px solid <%= product.panelColor || '#4f46e5' %>;">
                                <div class="product-image-wrap">
                                    <img src="/productImage/<%=product.image%>" alt="<%= product.name %>">
                                    <% if (product.discount > 0) { %>
                                        <span class="discount-badge"><%= product.discount %>% OFF</span>
                                    <% } %>
                                </div>
                                <div class="product-details">
                                    <h3><%= product.name %></h3>
                                    <p class="product-desc"><%= product.details || 'No description available.' %></p>
                                    
                                    <div class="price-row">
                                        <span class="current-price">₹<%= product.price - (product.price * (product.discount / 100)) %></span>
                                        <% if (product.discount > 0) { %>
                                            <span class="original-price">₹<%= product.price %></span>
                                        <% } %>
                                    </div>

                                    <div class="stock-info">
                                        <span>Status:</span>
                                        <% if (product.stocks > 5) { %>
                                            <span class="stock-status in-stock"><%= product.stocks %> units in stock</span>
                                        <% } else if (product.stocks > 0) { %>
                                            <span class="stock-status low-stock">Low Stock (<%= product.stocks %> remaining)</span>
                                        <% } else { %>
                                            <span class="stock-status out-of-stock">Out of Stock</span>
                                        <% } %>
                                    </div>

                                    <div class="card-actions">
                                                  <form
                                      action="/admin/Side/products/delete/<%= product._id %>"
                                      method="POST"
                                      class="delete-form"
                                      onsubmit="return confirm('Are you sure you want to delete this product?');">
                                      <button type="submit" class="btn btn-delete">Delete</button>
                                     </form>
                                    </div>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                <% } else { %>
                    <div class="empty-state">
                        <i class="ri-inbox-line"></i>
                        <h3>No products found</h3>
                        <p>You haven't listed any products yet. Click below to add your first product.</p>
                        <a href="/owner/<%=owner._id%>/productsCreate" class="btn btn-primary">Add Product</a>
                    </div>
                <% } %>
            </section>
        </main>
    </div>
</body>
</html>